# Copy values into your shell environment before running the app.
# Never commit a real API key.
DATABASE_URL=sqlite:///./cyber_opp.db
SCAN_INTERVAL_MINUTES=30

# Fill an empty database from the official e-GP history on first boot.
# Off locally; render.yaml turns it on for a fresh deployment.
BACKFILL_ON_EMPTY=false
BACKFILL_YEARS_BACK=12

# Comma-separated allowed origins when the dashboard calls the API directly.
# Leave unset when /api is proxied through the frontend host (no CORS needed).
# CORS_ORIGINS=https://your-site.netlify.app

# Optional: key from https://opend.data.go.th/register_api
# Without it, the adapter uses the public first-party GovSpending search API.
DATA_GO_TH_API_KEY=
